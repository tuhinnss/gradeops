# Application
APP_NAME=GRADEOPS
DEBUG=false
# development | test | production. In production the API refuses to start with
# the default JWT secret or with AUTH_ENABLED=false.
ENVIRONMENT=development
API_PREFIX=/api/v1

# Database (async PostgreSQL). The schema is managed by Alembic:
#   alembic upgrade head
DATABASE_URL=postgresql+asyncpg://gradeops:gradeops@localhost:5432/gradeops
# Only for throwaway experiments: create tables with create_all on startup.
DB_AUTO_CREATE=false

# Storage paths
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MODELS_CACHE_DIR=models_cache

# Storage backend: local | s3
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=gradeops

# OCR settings
# Options: florence2 | nougat | tesseract | easyocr | paddleocr
OCR_ENGINE=tesseract
OCR_DEVICE=cpu
OCR_PREPROCESS=true
FLORENCE_MODEL_ID=microsoft/Florence-2-base
NOUGAT_MODEL_ID=facebook/nougat-base

# Evaluation
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.55
BLANK_ANSWER_MIN_CHARS=3
PLAGIARISM_SIMILARITY_THRESHOLD=0.92
# When the embedding model cannot be loaded (offline host):
# lexical = keyword-only grading with capped confidence, error = fail evaluation
EMBEDDING_FALLBACK=lexical

# Optional AI (heuristic grading works offline without these)
AI_BACKEND=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct
USE_LLM_REASONING=false

# Auth. AUTH_ENABLED=false re-opens the legacy anonymous workbench endpoints
# (local demos only). The /professor and /ta dashboards always require login.
AUTH_ENABLED=true
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Self-registration only ever creates TA accounts with no course access.
# Professors are created with: python -m scripts.create_user --role professor
ALLOW_SELF_REGISTRATION=true
BCRYPT_ROUNDS=12

# Batch processing
BATCH_MAX_WORKERS=2

# PDF processing
PDF_DPI=200
MAX_UPLOAD_MB=50

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
